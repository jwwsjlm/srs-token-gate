# Docker Compose 启动参数。
# 业务配置（域名、管理员、Session、WebRTC candidate、Hook Secret）请修改：
# srs-token-gate/config.yaml

# Token Gate 宿主机监听地址。
# 域名反代模式填写 127.0.0.1，只允许本机 Nginx/OpenResty访问。
# 无域名 IP 直连模式填写 0.0.0.0，允许通过 http://服务器IP:GATEWAY_PORT 访问。
GATEWAY_BIND=127.0.0.1

# Token Gate 对外 HTTP 端口。域名反代通常保持 9085。
GATEWAY_PORT=9085

# RTMP 对外 TCP 端口，同时用于控制台生成推流地址。
RTMP_PORT=1935

# WebRTC 对外 UDP 端口；不使用 WebRTC 时可在防火墙中保持关闭。
RTC_UDP_PORT=8000

# WebRTC TCP fallback 对外端口；不使用 WebRTC 时可在防火墙中保持关闭。
RTC_TCP_PORT=8000

# Token Gate 生产镜像；服务器只拉取，不执行 Go 编译。
TOKEN_GATE_IMAGE=ghcr.io/jwwsjlm/srs-token-gate:latest
